# ---- Google OAuth client (Web application, from Google Cloud Console) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client:
GOOGLE_REDIRECT_URI=https://gauth.example.com/api/auth/callback

# Public/base URL the app uses to build redirects
APP_BASE_URL=https://gauth.example.com

# ---- /api/token shared secret (n8n HTTP-node flows). Required: the endpoint returns 503 without it ----
TOKEN_API_SECRET=change-me-long-random

# ---- Optional: push active token into an n8n credential ----
# n8n REST API base (note the /api/v1)
N8N_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=
# Optional: id of an existing "Google OAuth2 API" credential in n8n to overwrite.
# If blank, gauth creates the credential on first successful Google login.
N8N_CRED_ID=
N8N_CRED_TYPE=googleOAuth2Api

# ---- Token store (Docker volume) ----
TOKEN_STORE_PATH=/data/active-account.json
